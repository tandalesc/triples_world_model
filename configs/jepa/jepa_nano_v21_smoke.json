{
  "profile": "jepa_nano_v2",
  "seed": 0,
  "data": {
    "path": "data/glucose/chain_general_train.jsonl",
    "tokenizer": "data/glucose/jepa_bpe_512.json",
    "vocab_size": 512,
    "max_text_tokens": 64,
    "pairing": "adjacent",
    "append_eos": true,
    "max_chains": 2000
  },
  "model": {
    "d_model": 64,
    "d_noun": 32,
    "n_slots": 8,
    "n_verbs": 8,
    "block": 2,
    "n_text_layers": 2,
    "tie_text_layers": true,
    "n_heads": 4,
    "n_slot_iters": 3,
    "operator_group": "rotation_scale",
    "n_steps_T": 1,
    "use_polar_conditioning": true,
    "use_kind_head": false,
    "kind_codebook_size": 16,
    "transition": { "mlp_hidden": 128, "use_delta": true },
    "prior": { "mlp_hidden": 64 },
    "decoder": { "d_dec": 64, "n_layers": 1, "n_heads": 4, "d_ff": 128 }
  },
  "loss": {
    "w_token": 1.0,
    "w_prior": 0.1,
    "w_sigreg": 0.05,
    "w_pred": 0.25,
    "sigreg": { "n_slices": 256, "n_knots": 17, "knot_max": 3.0, "standardize": true },
    "verb": { "gumbel_tau_start": 3.0, "gumbel_tau_end": 1.0, "anneal_frac": 0.5 }
  },
  "ema": { "tau": 0.995, "schedule": "fixed" },
  "optim": {
    "lr": 3e-4,
    "weight_decay": 0.01,
    "batch_size": 64,
    "epochs": 3,
    "grad_clip": 1.0,
    "warmup_steps": 50
  },
  "eval": {
    "every_epochs": 1,
    "n_examples": 256,
    "out_dir": "results/jepa_nano_v21_smoke",
    "n_text_samples": 8,
    "temperatures": [0.7, 1.0]
  }
}

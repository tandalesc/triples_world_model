{
    "train_data": "data/mixed_v16_train.jsonl",
    "test_data": "data/mixed_v16_test.jsonl",
    "tokenizer_pretrained": "gpt2",
    "out_dir": "results/mixed_chain_v17c",
    "d_model": 64,
    "n_heads": 4,
    "d_ff": 256,
    "max_triples": 16,
    "dynamics_layers": 2,
    "compressor_layers": 3,
    "expander_layers": 3,
    "max_text_tokens": 128,
    "max_chain_len": 6,
    "no_path_a": true,
    "bleu_samples": 200,
    "pca_snapshots": true,
    "dropout": 0.1,
    "alpha_min": 0.01,
    "batch_size": 64,
    "lr": 3e-4,
    "epochs": 20,
    "log_every": 2,
    "eval_every": 2,
    "device": "cuda"
}

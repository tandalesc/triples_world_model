{
    "train_data": "data/arc_agi_3/arc_train.jsonl",
    "test_data": "data/arc_agi_3/arc_test.jsonl",
    "tokenizer": "bytes",
    "out_dir": "results/arc_v1",
    "d_model": 64,
    "n_heads": 4,
    "d_ff": 256,
    "max_triples": 8,
    "dynamics_layers": 2,
    "compressor_layers": 3,
    "expander_layers": 3,
    "max_text_tokens": 1024,
    "max_chain_len": 10,
    "bleu_samples": 50,
    "pca_snapshots": true,
    "dropout": 0.1,
    "alpha_min": 0.01,
    "batch_size": 4,
    "lr": 3e-4,
    "epochs": 50,
    "log_every": 5,
    "eval_every": 5,
    "device": "mps"
}

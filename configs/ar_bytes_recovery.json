{
    "train_data": "data/tw_all_train.jsonl",
    "test_data": "data/tw_all_test.jsonl",
    "tokenizer": "bytes",
    "inventory_path": "data/tw_entity_inventory.json",
    "out_dir": "results/ar_bytes_recovery",
    "d_model": 128,
    "n_heads": 4,
    "d_ff": 512,
    "max_triples": 16,
    "compressor_layers": 3,
    "dynamics_layers": 2,
    "decoder_layers": 2,
    "max_text_tokens": 512,
    "max_chain_len": 6,
    "consistency_weight": 1.0,
    "entity_weight_start": 0.0,
    "entity_weight_end": 0.0,
    "ema_decay": 0.999,
    "warmup_steps": 1000,
    "gen_samples": 200,
    "dropout": 0.1,
    "batch_size": 32,
    "lr": 1e-4,
    "epochs": 40,
    "log_every": 2,
    "eval_every": 5,
    "device": "cuda"
}

{
    "train_data": "data/mixed_v16_train.jsonl",
    "test_data": "data/mixed_v16_test.jsonl",
    "tokenizer_pretrained": "gpt2",
    "out_dir": "results/parallel_v1",
    "d_model": 128,
    "n_heads": 8,
    "d_ff": 512,
    "max_triples": 16,
    "dynamics_layers": 2,
    "compressor_layers": 3,
    "decoder_layers": 3,
    "max_text_tokens": 128,
    "max_chain_len": 6,
    "consistency_weight": 1.0,
    "decode_weight": 1.0,
    "ema_decay": 0.999,
    "bleu_samples": 200,
    "dropout": 0.1,
    "batch_size": 64,
    "lr": 1e-4,
    "epochs": 40,
    "log_every": 2,
    "eval_every": 2,
    "device": "cuda"
}

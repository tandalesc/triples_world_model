{
    "train_data": "data/glucose/augmented_chain_general_train.jsonl",
    "test_data": "data/glucose/augmented_chain_general_test.jsonl",
    "tokenizer_pretrained": "gpt2",
    "out_dir": "results/glucose_chain_v5",

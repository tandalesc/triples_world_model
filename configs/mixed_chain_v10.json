    "max_text_tokens": 300,
    "max_chain_len": 6,
    "bleu_samples": 200,
    "pca_snapshots": true,
    "sigreg_weight": 0.01,
    "dropout": 0.1,
    "alpha_min": 0.01,
    "batch_size": 64,
    "lr": 3e-4,
    "epochs": 20,
    "log_every": 2,
    "eval_every": 2,
    "device": "cuda"
}

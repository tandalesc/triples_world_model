{
    "train_data": "data/mixed_train.jsonl",
    "test_data": "data/mixed_test.jsonl",
    "tokenizer": "bytes",
    "out_dir": "results/mixed_chain_v10",
    "d_model": 64,
    "n_heads": 4,
    "d_ff": 256,
    "max_triples": 8,
    "dynamics_layers": 2,
    "compressor_layers": 3,

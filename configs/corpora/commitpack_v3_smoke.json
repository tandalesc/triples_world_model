{
  "_comment": "CommitPackFT 2-epoch local smoke on the 1500-transition sample (mps). pairs mode (length-2 chains). max_chains caps the pair count (pairs mode cap = max_chains*2 inside the trainer, but length-2 -> 1 pair/chain, so effective cap ~= max_chains). Uses the sample BPE (8192 actual on commitpack).",
  "profile": "jepa_v3",
  "seed": 0,
  "data": {
    "path": "data/commitpack/train.jsonl",
    "tokenizer": "data/commitpack/bpe_8192.json",
    "vocab_size": 8192,
    "max_text_tokens": 192,
    "pairing": "adjacent",
    "mode": "pairs",
    "append_eos": true,
    "max_chains": 1000
  },
  "model": {
    "d_model": 96,
    "d_noun": 48,
    "n_slots": 8,
    "n_verbs": 12,
    "block": 2,
    "n_text_layers": 2,
    "tie_text_layers": true,
    "n_heads": 4,
    "n_slot_iters": 3,
    "operator_group": "gated_mlp",
    "n_steps_T": 1,
    "use_polar_conditioning": false,
    "use_kind_head": false,
    "kind_codebook_size": 16,
    "transition": { "mlp_hidden": 192, "use_delta": true },
    "prior": { "mlp_hidden": 96 },
    "decoder": { "d_dec": 192, "n_layers": 2, "n_heads": 4, "d_ff": 384 },
    "gated_mlp": { "d_e": 4, "d_h": 8 }
  },
  "loss": {
    "w_token": 1.0, "w_prior": 0.1, "w_sigreg": 0.05, "w_pred": 0.0, "w_nce": 0.25,
    "sigreg": { "n_slices": 256, "n_knots": 17, "knot_max": 3.0, "standardize": true },
    "verb": { "gumbel_tau_start": 3.0, "gumbel_tau_end": 1.0, "anneal_frac": 0.5 },
    "nce": { "temperature": 0.1 },
    "unroll": { "hop_weights": [1.0, 0.5] }
  },
  "ema": { "tau": 0.995, "schedule": "fixed" },
  "optim": {
    "lr": 0.0003, "weight_decay": 0.01, "batch_size": 32, "epochs": 2,
    "grad_clip": 1.0, "warmup_steps": 20
  },
  "eval": {
    "every_epochs": 1, "n_examples": 128,
    "out_dir": "results/commitpack_v3_smoke",
    "n_text_samples": 8, "temperatures": [0.7, 1.0]
  }
}

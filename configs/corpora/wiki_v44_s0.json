{
  "_comment": "v4.4 scale-up: masked-reconstruction on Wikipedia consecutive-sentence chains (data-pressure limit case). DROPS the action-labeled world-model requirement; the question is whether the slot encoder can reproduce diverse free-form prose under masking and build metric pooled geometry when surface variety is unbounded. Recipe = masked arm (w_masked_diff=1.0, mask_mode=random_span), w_token=0.5 generation floor, corrosive margin/pool-nce OFF. Structured operator (rotation_scale + polar + norm_budget + targeted) arm. vocab 8192 -> token_emb=8192*d_model dominates params; d_model=96 -> ~0.79M emb + decoder/transition ~ total ~1.5-2M. max_text_tokens=80 set from BPE sentence coverage (rebuild + check bpe_8192_coverage.json on the server; bump to the recommended_max if p99 exceeds 80). entity_world.enabled=true ONLY to surface separation-AUC off the PLAIN test.jsonl (no _labeled twin exists -> action-NMI/ladder/rollout skip gracefully).",
  "profile": "jepa_v3",
  "seed": 0,
  "data": {
    "path": "data/wikipedia/train.jsonl",
    "tokenizer": "data/wikipedia/bpe_8192.json",
    "vocab_size": 8192,
    "max_text_tokens": 80,
    "pairing": "adjacent",
    "mode": "triples",
    "append_eos": true,
    "mask_mode": "random_span"
  },
  "model": {
    "d_model": 96,
    "d_noun": 48,
    "n_slots": 8,
    "n_verbs": 12,
    "block": 2,
    "n_text_layers": 2,
    "tie_text_layers": true,
    "n_heads": 4,
    "n_slot_iters": 3,
    "operator_group": "rotation_scale",
    "n_steps_T": 1,
    "use_polar_conditioning": true,
    "use_norm_budget": true,
    "use_targeted_actions": true,
    "use_kind_head": false,
    "kind_codebook_size": 16,
    "transition": {
      "mlp_hidden": 192,
      "use_delta": true
    },
    "prior": {
      "mlp_hidden": 96
    },
    "decoder": {
      "d_dec": 192,
      "n_layers": 2,
      "n_heads": 4,
      "d_ff": 384
    },
    "targeted": {
      "mask_hidden": 96
    }
  },
  "loss": {
    "w_token": 0.5,
    "w_prior": 0.1,
    "w_sigreg": 0.05,
    "w_pred": 0.0,
    "w_nce": 0.25,
    "w_diff": 1.0,
    "w_margin": 0.0,
    "margin": 2.0,
    "w_mask_prior": 0.02,
    "w_masked_diff": 1.0,
    "sigreg": {
      "n_slices": 256,
      "n_knots": 17,
      "knot_max": 3.0,
      "standardize": true
    },
    "verb": {
      "gumbel_tau_start": 3.0,
      "gumbel_tau_end": 1.0,
      "anneal_frac": 0.5
    },
    "nce": {
      "temperature": 0.1
    },
    "unroll": {
      "hop_weights": [
        1.0,
        0.5
      ]
    },
    "w_pool_nce": 0.0,
    "tau_pool": 0.1,
    "n_pool_negs": 16,
    "pool_nce_stop_grad_pos": false
  },
  "ema": {
    "tau": 0.995,
    "schedule": "fixed"
  },
  "optim": {
    "lr": 0.0003,
    "weight_decay": 0.01,
    "batch_size": 24,
    "epochs": 60,
    "grad_clip": 1.0,
    "warmup_steps": 500
  },
  "eval": {
    "every_epochs": 5,
    "n_examples": 512,
    "out_dir": "results/wiki_v44_s0",
    "n_text_samples": 16,
    "temperatures": [
      0.7,
      1.0
    ],
    "entity_world": {
      "enabled": true,
      "labeled_dir": "data/wikipedia",
      "splits": [
        "test"
      ],
      "subsample": 512,
      "n_rollout_chains": 128,
      "rollout_max_depth": 2,
      "action_recovery_split": "test"
    }
  }
}
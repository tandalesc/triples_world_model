{
  "_comment": "wikiHow procedural chains (gursi26/wikihow-cleaned). Open-domain prose, ~6 steps/chain. vocab 8192 (~13x the 512 worlds) raises token_emb to 8192*d_model=8192*96~=0.79M params -> total ~1.5-2M (M-scale). max_text_tokens=64 covers >99% of headline-states (measured p99~33; survey's 96-128 guess was for full step paragraphs, but the cleaned summary gives short headlines). triples mode: chains are length>=2, so set min-steps>=3 in the converter for triple mode, else use pairs.",
  "profile": "jepa_v3",
  "seed": 0,
  "data": {
    "path": "data/wikihow/train.jsonl",
    "tokenizer": "data/wikihow/bpe_8192.json",
    "vocab_size": 8192,
    "max_text_tokens": 64,
    "pairing": "adjacent",
    "mode": "triples",
    "append_eos": true
  },
  "model": {
    "d_model": 96,
    "d_noun": 48,
    "n_slots": 8,
    "n_verbs": 12,
    "block": 2,
    "n_text_layers": 2,
    "tie_text_layers": true,
    "n_heads": 4,
    "n_slot_iters": 3,
    "operator_group": "gated_mlp",
    "n_steps_T": 1,
    "use_polar_conditioning": false,
    "use_kind_head": false,
    "kind_codebook_size": 16,
    "transition": { "mlp_hidden": 192, "use_delta": true },
    "prior": { "mlp_hidden": 96 },
    "decoder": { "d_dec": 192, "n_layers": 2, "n_heads": 4, "d_ff": 384 },
    "gated_mlp": { "d_e": 4, "d_h": 8 }
  },
  "loss": {
    "w_token": 1.0, "w_prior": 0.1, "w_sigreg": 0.05, "w_pred": 0.0, "w_nce": 0.25,
    "sigreg": { "n_slices": 256, "n_knots": 17, "knot_max": 3.0, "standardize": true },
    "verb": { "gumbel_tau_start": 3.0, "gumbel_tau_end": 1.0, "anneal_frac": 0.5 },
    "nce": { "temperature": 0.1 },
    "unroll": { "hop_weights": [1.0, 0.5] }
  },
  "ema": { "tau": 0.995, "schedule": "fixed" },
  "optim": {
    "lr": 0.0003, "weight_decay": 0.01, "batch_size": 128, "epochs": 60,
    "grad_clip": 1.0, "warmup_steps": 500
  },
  "eval": {
    "every_epochs": 5, "n_examples": 512,
    "out_dir": "results/wikihow_v3",
    "n_text_samples": 16, "temperatures": [0.7, 1.0]
  }
}

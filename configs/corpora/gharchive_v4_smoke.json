{
  "_comment": "GH Archive issue/PR lifecycle 2-epoch local smoke (mps) on the ~4000-chain 9-hour sample. PAIRS mode: GH chains are mostly length 2 (mean ~2.2 events), so triples mode would skip most; pairs yields 1 transition/length-2 chain (same handling as commitpack). Sample BPE data/gharchive/bpe_8192.json (actual vocab 6344; vocab_size 8192 >= actual -> spare rows). max_text_tokens=64 covers 99.85% (measured p99=46). max_chains caps to the sample.",
  "profile": "jepa_v3",
  "seed": 0,
  "data": {
    "path": "data/gharchive/train.jsonl",
    "tokenizer": "data/gharchive/bpe_8192.json",
    "vocab_size": 8192,
    "max_text_tokens": 64,
    "pairing": "adjacent",
    "mode": "pairs",
    "append_eos": true,
    "max_chains": 2000
  },
  "model": {
    "d_model": 96,
    "d_noun": 48,
    "n_slots": 8,
    "n_verbs": 12,
    "block": 2,
    "n_text_layers": 2,
    "tie_text_layers": true,
    "n_heads": 4,
    "n_slot_iters": 3,
    "operator_group": "gated_mlp",
    "n_steps_T": 1,
    "use_polar_conditioning": false,
    "use_kind_head": false,
    "kind_codebook_size": 16,
    "transition": { "mlp_hidden": 192, "use_delta": true },
    "prior": { "mlp_hidden": 96 },
    "decoder": { "d_dec": 192, "n_layers": 2, "n_heads": 4, "d_ff": 384 },
    "gated_mlp": { "d_e": 4, "d_h": 8 }
  },
  "loss": {
    "w_token": 1.0, "w_prior": 0.1, "w_sigreg": 0.05, "w_pred": 0.0, "w_nce": 0.25,
    "sigreg": { "n_slices": 256, "n_knots": 17, "knot_max": 3.0, "standardize": true },
    "verb": { "gumbel_tau_start": 3.0, "gumbel_tau_end": 1.0, "anneal_frac": 0.5 },
    "nce": { "temperature": 0.1 },
    "unroll": { "hop_weights": [1.0, 0.5] }
  },
  "ema": { "tau": 0.995, "schedule": "fixed" },
  "optim": {
    "lr": 0.0003, "weight_decay": 0.01, "batch_size": 64, "epochs": 2,
    "grad_clip": 1.0, "warmup_steps": 20
  },
  "eval": {
    "every_epochs": 1, "n_examples": 128,
    "out_dir": "results/gharchive_v4_smoke",
    "n_text_samples": 8, "temperatures": [0.7, 1.0]
  }
}
